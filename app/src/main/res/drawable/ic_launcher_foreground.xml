<?xml version="1.0" encoding="utf-8"?>
<!-- The ghost sail: a ship's sail whose foot is the wraith's tattered hem,
     with two eyes. Odysseus told the Cyclops his name was Nobody; a wraith is
     nobody, and this is his ship. A corner (the peak) and an asymmetry (a
     right-angled sail) rather than a radial mark, so it still reads at 16px
     and inside a circle. Every point sits inside the adaptive-icon safe zone,
     the centred 66dp circle of this 108dp viewport; the peak is the farthest,
     31.6dp from centre. The same sail with the eyes cut out is the
     monochrome layer, and docs/assets/icon.svg draws the same shapes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sail -->
    <path
        android:pathData="M44,24 L74,76 L69,70 L64,76 L59,70 L54,76 L49,70 L44,76 Z"
        android:fillColor="#E06C75" />

    <!-- Eyes -->
    <path
        android:pathData="M47,60 A3,3 0 1,0 53,60 A3,3 0 1,0 47,60 Z"
        android:fillColor="#9CDEF2" />
    <path
        android:pathData="M55,60 A3,3 0 1,0 61,60 A3,3 0 1,0 55,60 Z"
        android:fillColor="#9CDEF2" />
</vector>
