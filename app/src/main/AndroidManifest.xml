<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The only permission. No notifications, no storage: attachments come
         through the system Photo Picker and document picker, which need
         none, and a received attachment is opened from the app's own cache
         through the FileProvider below. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- No usesCleartextTraffic: https only, Android's default since API 28
         (net/HostPolicy.kt refuses an http address with a reason). Tailscale
         serves https for *.ts.net names. allowBackup is off and there are no dataExtractionRules
         on purpose: the session cookie is sealed with a Keystore key that
         never leaves the device, so a restored copy would be useless. -->
    <application
        android:name=".WraithOdysseusApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.WraithOdysseus"
        android:supportsRtl="true"
        tools:ignore="DataExtractionRules">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands one cached attachment to the app that opens it. Not
             exported: access is granted per intent, for that one file. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
